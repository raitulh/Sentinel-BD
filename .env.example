# Copy to .env and replace every placeholder before starting the stack.
APP_ENV=development
SECRET_KEY=replace-this-with-a-random-64-character-secret-before-running
BOOTSTRAP_TOKEN=replace-this-with-a-random-bootstrap-token-at-least-24-chars
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-this-with-a-strong-database-password
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
MAX_UPLOAD_BYTES=209715200
VIDEO_FRAME_STRIDE=5
VIDEO_MOTION_THRESHOLD=0.08
VIDEO_MIN_GAP_SECONDS=2.0
MAX_VIDEO_DURATION_SECONDS=3600
MAX_VIDEO_FRAMES=100000
WORKER_POLL_SECONDS=2.0
JOB_STALE_MINUTES=180
MAX_JOB_ATTEMPTS=3
LOG_LEVEL=INFO
HTTP_BIND_ADDRESS=127.0.0.1
